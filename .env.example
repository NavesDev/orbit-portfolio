# Portfolio content, read by apps/web through @portfolio/db
DATABASE_URL=postgres://user:password@host:5432/portfolio

# Telemetry storage, owned by @portfolio/telemetry
TELEMETRY_DATABASE_URL=postgres://user:password@host:5432/telemetry

# Comma-separated origins allowed to post telemetry events
TELEMETRY_ALLOWED_ORIGINS=https://seudominio.com,https://outroprojeto.com

# Integration tests only. No default on purpose: an unset value must fail the
# run rather than fall back to a database that happens to be reachable.
TEST_DATABASE_URL=
