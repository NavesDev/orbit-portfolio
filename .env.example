# Portfolio content, read by apps/web through @portfolio/db.
# This value matches docker-compose.yml, so a local copy of this file works
# against `docker compose up -d postgres` unchanged.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# Telemetry storage, owned by @portfolio/telemetry. Deferred to Phase 6 —
# docker-compose.yml has no service for it yet, so this stays a placeholder.
TELEMETRY_DATABASE_URL=postgres://user:password@host:5432/telemetry

# Comma-separated origins allowed to post telemetry events
TELEMETRY_ALLOWED_ORIGINS=https://seudominio.com,https://outroprojeto.com

# Integration tests only. Left blank on purpose: an unset value must fail the
# run rather than fall back to a database that happens to be reachable. Set it
# deliberately — against docker-compose.yml that is
# postgres://portfolio:portfolio@localhost:5432/portfolio, which names the
# server only; each test file creates and drops a scratch database of its own.
TEST_DATABASE_URL=
