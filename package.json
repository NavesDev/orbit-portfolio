{
  "name": "personal-portfolio",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --passWithNoTests --project core --project web --project db-unit",
    "test:watch": "vitest",
    "test:integration": "vitest run --passWithNoTests --project db",
    "test:e2e": "pnpm --filter @portfolio/web test:e2e",
    "db:migrate": "pnpm --filter @portfolio/db migrate",
    "db:seed": "pnpm --filter @portfolio/db seed"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
